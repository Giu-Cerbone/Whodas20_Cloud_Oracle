-- public.tab_type_compile_quest definition

-- Drop table

-- DROP TABLE public.tab_type_compile_quest;

CREATE TABLE public.tab_type_compile_quest (
	id int8 GENERATED BY DEFAULT AS IDENTITY( INCREMENT BY 1 MINVALUE 1 MAXVALUE 9223372036854775807 START 1 CACHE 1 NO CYCLE) NOT NULL,
	desc_type varchar(100) NOT NULL,
	specific_desc text NULL,
	additional_notes text NULL,
	CONSTRAINT tab_type_compile_quest_desc_type_not_null NOT NULL desc_type,
	CONSTRAINT tab_type_compile_quest_id_not_null NOT NULL id,
	CONSTRAINT tab_type_compile_quest_pkey PRIMARY KEY (id)
);
CREATE INDEX idx_tab_type_compile_quest_desc ON public.tab_type_compile_quest USING btree (desc_type);