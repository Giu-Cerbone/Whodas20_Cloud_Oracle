<?xml version="1.0" encoding="UTF-8"?>
<email-template>
    <metadata>
        <name>whodas-password-reset</name>
        <version>1.0</version>
        <description>Template email per reset password WHODAS 2.0</description>
        <author>WHODAS Team</author>
        <created>2026-11-25</created>
    </metadata>

    <placeholders>
        <placeholder key="RESET_LINK" description="Link per il reset password" required="true"/>
        <placeholder key="EXPIRY_HOURS" description="Ore di validità del link" required="true"/>
        <placeholder key="USER_FIRST_NAME" description="Nome utente" required="false" default=""/>
        <placeholder key="USER_LAST_NAME" description="Cognome utente" required="false" default=""/>
        <placeholder key="ACCOUNT_NAME" description="Nome account / Username" required="false" default=""/>
        <placeholder key="APP_NAME" description="Nome applicazione" required="false" default="WHODAS 2.0"/>
        <placeholder key="SUPPORT_EMAIL" description="Email supporto" required="false" default="whodas_info@yahoo.com"/>
        <placeholder key="YEAR" description="Anno corrente" required="false" default="2026"/>
    </placeholders>

    <subject><![CDATA[${APP_NAME} - Reset Password]]></subject>

    <html-body><![CDATA[
<!DOCTYPE html>
<html lang="it" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="x-apple-disable-message-reformatting">
    <title>${APP_NAME} - Reset Password</title>
    <!--[if mso]>
    <noscript>
        <xml>
            <o:OfficeDocumentSettings>
                <o:PixelsPerInch>96</o:PixelsPerInch>
            </o:OfficeDocumentSettings>
        </xml>
    </noscript>
    <![endif]-->
    <style type="text/css">
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

        * { box-sizing: border-box; }
        body { margin: 0; padding: 0; background-color: #f4f6fb; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; line-height: 1.6; color: #1f2937; }
        table { border-collapse: collapse; }
        img { border: 0; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; }
        a { text-decoration: none; color: #3d4fa0; }
        a:hover { color: #2d3d8a; }

        @media only screen and (max-width: 600px) {
            .container { width: 100% !important; max-width: 100% !important; }
            .content { padding: 24px 16px !important; }
            .header { padding: 32px 16px !important; }
            .button { display: block !important; width: 100% !important; text-align: center !important; padding: 16px 24px !important; }
            .footer { padding: 24px 16px !important; }
            .logo-text { font-size: 24px !important; }
        }

        @media only screen and (max-width: 400px) {
            .header { padding: 24px 12px !important; }
            .content { padding: 20px 12px !important; }
            .button { font-size: 15px !important; padding: 14px 20px !important; }
        }
    </style>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f6fb;">
    <!-- Preheader text -->
    <div style="display: none; max-height: 0; overflow: hidden; font-size: 1px; line-height: 1px; color: #f4f6fb; opacity: 0;">
        Hai richiesto il reset della password per il tuo account : &nbsp; ${ACCOUNT_NAME}. Clicca per impostare una nuova password temporanea.
    </div>

    <!-- Wrapper -->
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color: #f4f6fb; min-width: 100%;">
        <tr>
            <td align="center" style="padding: 40px 16px;">
                <!-- Main Container -->
                <table role="presentation" class="container" width="100%" max-width="600" cellspacing="0" cellpadding="0" border="0" style="background-color: #ffffff; border-radius: 16px; box-shadow: 0 4px 24px rgba(31, 41, 55, 0.08), 0 1px 3px rgba(31, 41, 55, 0.05); overflow: hidden;">

                    <!-- Header -->
                    <tr>
                        <td class="header" style="background: linear-gradient(135deg, #3d4fa0 0%, #2d3d8a 50%, #1e2a6b 100%); padding: 10px 12px; text-align: center; position: relative; overflow: hidden; white-space: nowrap;">
                            <!-- Decorative background elements (small, absolute) -->
                            <div style="position: absolute; top: -10px; right: -10px; width: 50px; height: 50px; background: rgba(255,255,255,0.05); border-radius: 50%;"></div>
                            <div style="position: absolute; bottom: -8px; left: -8px; width: 36px; height: 36px; background: rgba(255,255,255,0.03); border-radius: 50%;"></div>
                            <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 70px; height: 70px; background: radial-gradient(circle, rgba(255,255,255,0.04) 0%, transparent 70%); border-radius: 50%; pointer-events: none;"></div>

                            <!-- Logo & Title (single compact row) -->
                            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="position: relative; z-index: 1;">
                                <tr>
                                    <td align="center" style="white-space: nowrap;">
                                        <span class="logo-text" style="font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 16px; font-weight: 700; color: #ffffff; letter-spacing: -0.5px; vertical-align: middle;">${APP_NAME}</span>
                                        <span style="font-family: 'Inter', sans-serif; font-size: 10px; font-weight: 400; color: rgba(255,255,255,0.85); letter-spacing: 0.5px; text-transform: uppercase; vertical-align: middle;">&nbsp;&middot;&nbsp;Reset Password</span>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td class="content" style="padding: 40px 32px;">
                            <!-- Greeting -->
                            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                                <tr>
                                    <td style="padding-bottom: 24px;">
                                        <p style="margin: 0 0 8px 0; font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 500; color: #1f2937;">Gentile : &nbsp;<strong>${USER_FIRST_NAME}&nbsp;${USER_LAST_NAME}</strong>,</p>
                                        <p style="margin: 0; font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 400; color: #4b5563; line-height: 1.6;">Hai richiesto il reset della password per il tuo account : &nbsp; <strong style="color: #1f2937;">${ACCOUNT_NAME}</strong>.</p>
                                    </td>
                                </tr>

                                <!-- Description -->
                                <tr>
                                    <td style="padding-bottom: 32px;">
                                        <p style="margin: 0; font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 400; color: #4b5563; line-height: 1.6;">Clicca sul pulsante qui sotto per impostare una nuova password temporanea sicura:</p>
                                    </td>
                                </tr>

                                <!-- CTA Button -->
                                <tr>
                                    <td align="center" style="padding-bottom: 32px;">
                                        <!--[if mso]>
                                        <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="${RESET_LINK}" style="height:52px;v-text-anchor:middle;width:280px;" arcsize="12%" stroke="f" fillcolor="#3d4fa0">
                                            <w:anchorlock/>
                                            <center style="color:#ffffff;font-family:'Inter',sans-serif;font-size:16px;font-weight:600;">Imposta Password Temporanea (Reset)</center>
                                        </v:roundrect>
                                        <![endif]-->
                                        <![if !mso]><!-->
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                                            <tr>
                                                <td align="center" style="border-radius: 10px; background: linear-gradient(135deg, #3d4fa0 0%, #2d3d8a 100%); box-shadow: 0 4px 14px rgba(61, 79, 160, 0.35);">
                                                    <a href="${RESET_LINK}" target="_blank" class="button" style="display: inline-block; padding: 16px 32px; font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 600; color: #ffffff; text-decoration: none; border-radius: 10px; letter-spacing: 0.2px; transition: all 0.2s ease;">
                                                        Imposta Password Temporanea (Reset)
                                                    </a>
                                                </td>
                                            </tr>
                                        </table>
                                        <!--<![endif]-->
                                    </td>
                                </tr>

                                <!-- Link fallback -->
                                <tr>
                                    <td style="padding-bottom: 24px; text-align: center;">
                                        <p style="margin: 0; font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 400; color: #9ca3af;">Se il pulsante non funziona, copia e incolla questo link nel browser:</p>
                                        <p style="margin: 8px 0 0 0; font-family: 'Inter', monospace; font-size: 12px; font-weight: 400; color: #3d4fa0; word-break: break-all; background: #f9fafb; padding: 12px; border-radius: 8px; border: 1px solid #e5e7eb;">${RESET_LINK}</p>
                                    </td>
                                </tr>

                                <!-- Divider -->
                                <tr>
                                    <td style="padding: 24px 0;">
                                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                                            <tr>
                                                <td style="border-top: 1px solid #e5e7eb;"></td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <!-- Expiry info -->
                                <tr>
                                    <td style="padding-bottom: 16px;">
                                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                                            <tr>
                                                <td width="40" style="vertical-align: top; padding-right: 12px;">
                                                    <div style="width: 40px; height: 40px; background: #fef3c7; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <circle cx="12" cy="12" r="10" stroke="#f59e0b" stroke-width="1.5"/>
                                            <path d="M12 6v6l4 4" stroke="#f59e0b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                                    </div>
                                                </td>
                                                <td style="vertical-align: top;">
                                                    <p style="margin: 0 0 4px 0; font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 600; color: #1f2937;">Link a scadenza</p>
                                                    <p style="margin: 0; font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 400; color: #6b7280;">Questo link scadrà tra <strong style="color: #f59e0b;">${EXPIRY_HOURS} ore</strong> per motivi di sicurezza.</p>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <!-- Security notice -->
                                <tr>
                                    <td style="padding-bottom: 8px;">
                                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                                            <tr>
                                                <td width="40" style="vertical-align: top; padding-right: 12px;">
                                                    <div style="width: 40px; height: 40px; background: #fee2e2; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M12 9v4M12 17h.01" stroke="#ef4444" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" stroke="#ef4444" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                                    </div>
                                                </td>
                                                <td style="vertical-align: top;">
                                                    <p style="margin: 0 0 4px 0; font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 600; color: #1f2937;">Sicurezza</p>
                                                    <p style="margin: 0; font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 400; color: #6b7280;">Se non hai richiesto questo reset, puoi ignorare questa email. La tua password rimarrà invariata.</p>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td class="footer" style="background: #f9fafb; padding: 32px; text-align: center; border-top: 1px solid #e5e7eb;">
                            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                                <tr>
                                    <td align="center" style="padding-bottom: 16px;">
                                        <span style="font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 600; color: #3d4fa0;">${APP_NAME}</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="padding-bottom: 12px;">
                                        <p style="margin: 0; font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 400; color: #6b7280;">Piattaforma per la valutazione della salute e disabilità</p>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="padding-bottom: 12px;">
                                        <p style="margin: 0; font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 400; color: #6b7280;">Ideatore e Sviluppo : Giuseppe Cerbone - Contatta via email:&nbsp; <a href="mailto:giuseppe_cerbone@hotmail.com?subject=Richiesta%20Informazioni%20Whodas%202.0"><strong>giuseppe_cerbone@hotmail.com</strong></a></p>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="padding-bottom: 20px;">
                                        <p style="margin: 0; font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 400; color: #9ca3af;">© ${YEAR} ${APP_NAME}. Tutti i diritti riservati.</p>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center">
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                                            <tr>
                                                <td style="padding: 0 12px;">
                                                    <a href="mailto:${SUPPORT_EMAIL}" style="font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 500; color: #3d4fa0; text-decoration: none;">Supporto</a>
                                                </td>
                                                <td style="padding: 0 12px; color: #d1d5db;">•</td>
                                                <td style="padding: 0 12px;">
                                                    <a href="#" style="font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 500; color: #3d4fa0; text-decoration: none;">Privacy</a>
                                                </td>
                                                <td style="padding: 0 12px; color: #d1d5db;">•</td>
                                                <td style="padding: 0 12px;">
                                                    <a href="#" style="font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 500; color: #3d4fa0; text-decoration: none;">Termini</a>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                </table>

                <!-- Disclaimer -->
                <table role="presentation" width="100%" max-width="600" cellspacing="0" cellpadding="0" border="0" style="margin-top: 24px;">
                    <tr>
                        <td align="center" style="padding: 0 16px;">
                            <p style="margin: 0; font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 400; color: #9ca3af; line-height: 1.5;">Questa email è stata inviata automaticamente, ti preghiamo di non rispondere.<br>Se hai bisogno di assistenza, contatta <a href="mailto:${SUPPORT_EMAIL}" style="color: #3d4fa0; text-decoration: underline;">${SUPPORT_EMAIL}</a></p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
    ]]></html-body>

    <text-body><![CDATA[
${APP_NAME} - Reset Password

Gentile ${USER_FIRST_NAME} ${USER_LAST_NAME},

Hai richiesto il reset della password per il tuo account : &nbsp;${ACCOUNT_NAME}.

Per impostare una nuova password temporanea, clicca sul link seguente:
${RESET_LINK}

Il link scadrà tra ${EXPIRY_HOURS} ore per motivi di sicurezza.

Se non hai richiesto questo reset, puoi ignorare questa email. La tua password rimarrà invariata.

---
${APP_NAME} - Piattaforma per la valutazione della salute e disabilità
© ${YEAR} ${APP_NAME}. Tutti i diritti riservati.

Supporto: ${SUPPORT_EMAIL}
    ]]></text-body>

</email-template>